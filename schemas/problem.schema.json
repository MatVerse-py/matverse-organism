{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/MatVerse-py/matverse-organism/schemas/problem.schema.json",
  "title": "Problem",
  "description": "A problem as admitted to the Campo de Hipóteses.",
  "type": "object",
  "required": ["id", "objective", "scope", "hypotheses"],
  "properties": {
    "id":          {"type": "string", "minLength": 1},
    "objective":   {"type": "string", "minLength": 1},
    "scope":       {"type": "string"},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "stakeholders": {"type": "array", "items": {"type": "string"}},
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "hypothesis.schema.json"}
    },
    "metadata": {
      "type": "object",
      "properties": {
        "science_origin":   {"type": "string"},
        "contract":         {"type": "string"},
        "ecosystem_impact": {"type": "string"},
        "lineage":          {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  }
}
